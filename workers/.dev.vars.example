# Sample local-dev vars for `npx wrangler dev` (copy to workers/.dev.vars —
# that file is gitignored and must NEVER be committed or present at deploy).
# ADMIN_BYPASS=1 skips Cloudflare Access JWT verification on /admin and
# /upload so the upload page can be tested locally. The deployed Worker must
# never have this var; Access JWT verification is the only gate there.
ADMIN_BYPASS=1

# Optional: real upstream keys for local AI-proxy testing. Note the local
# machine's network may not reach all upstreams; production verification
# happens against the deployed Worker instead.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# XAI_API_KEY=xai-...
