// Wrangler config for the comments/uploader/AI-proxy backend Worker.
// Deploy from this directory:  npx wrangler deploy
//
// WARNING: the D1 binding below is what the Worker's code calls `env.DB`.
// Deploying without it makes every /comments, /upload and /api/ai endpoint
// fail with 500.
{
  "name": "nathanpenny-api",
  "main": "comments.js",
  "compatibility_date": "2026-07-09",
  // Two triggers: the 15-min one publishes due scheduled drafts (drafts.js),
  // the nightly one prunes ai_logs / ai_usage / comment_rate / analytics
  // (pruneTables in comments.js). 03:17 UTC — off-peak for the APAC audience.
  "triggers": {
    "crons": ["17 3 * * *", "*/15 * * * *"]
  },
  "workers_dev": true,
  "preview_urls": false,
  // Captures console.log (access-verify stage logging) for debugging.
  "observability": {
    "enabled": true
  },
  // Keep dashboard-managed plain-text vars from being wiped on deploy.
  // (Secrets like TURNSTILE_SECRET are never touched by deploy.)
  "keep_vars": true,
  "vars": {
    // Public config for Access JWT verification on /admin + /upload.
    // ACCESS_AUD is filled from the Access application's AUD tag.
    "ACCESS_TEAM_DOMAIN": "square-surf-c2a6.cloudflareaccess.com",
    "ACCESS_AUD": "36ba044e69b4947e6cacfe51b9f0f33a1c492babd563080b313c3513beb040db",
    // Account ID for the Workers AI OpenAI-compat REST route (cf-* models,
    // the proxy's single upstream since 2026-09).
    "CF_ACCOUNT_ID": "aa23021279f1ffd6901d7093879554f3"
  },
  // Image uploader storage (music bucket shared; uploads land under img/).
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "nathanpenny-fun"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nathanpenny",
      "database_id": "a01603c4-40b4-41f9-bf73-bb9257a9155c"
    }
  ],
  // New-comment owner notification (comments.js sendNotifyEmail). The
  // destination is a domain address that an Email Routing rule relays into
  // the owner's real mailbox — deliberately not inlined here, so this
  // public repo never exposes it. Must stay a VERIFIED destination address
  // (Email Routing -> Destination Addresses), else sends fail (logged only).
  "send_email": [
    {
      "name": "NOTIFY",
      "destination_address": "notify@nathanpenny.fun"
    }
  ]
}
